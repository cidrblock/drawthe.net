{
  "name": "drawthe.net",
  "version": "2.0.2",
  "description": "drawthe.net: decent looking diagrams for engineers - draw network diagrams from YAML",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cidrblock/drawthe.net.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "files": [
    "bin/",
    "public/images/",
    "src/cli/",
    "src/renderer/"
  ],
  "bin": {
    "drawthe-net": "bin/drawthe-net.js"
  },
  "scripts": {
    "predev": "npm run icons:list",
    "dev": "vite",
    "prebuild": "npm run icons:list",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "render": "tsx src/cli/render.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "mcp": "tsx mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "icons:list": "tsx scripts/icons/build-icon-families.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@resvg/resvg-js": "^2.6.2",
    "d3": "^7.9.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^27.4.0",
    "showdown": "^2.1.0",
    "sirv-cli": "^3.0.1",
    "tsx": "^4.19.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "ajv": "^8.20.0",
    "bootstrap": "^5.3.8",
    "eslint": "^8.57.1",
    "font-awesome": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "monaco-yaml": "^5.5.1",
    "prettier": "^3.4.2",
    "save-svg-as-png": "^1.4.17",
    "svgo": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
