{
  "name": "drawthe.net",
  "version": "2.0.0",
  "description": "drawthe.net: decent looking diagrams for engineers - draw network diagrams from YAML",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "npm run icons:list",
    "dev": "vite",
    "prebuild": "npm run icons:list",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "render": "tsx src/cli/render.ts",
    "mcp": "tsx mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "icons:list": "tsx scripts/icons/build-icon-families.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@resvg/resvg-js": "^2.6.2",
    "ace-builds": "^1.36.5",
    "bootstrap": "^3.4.1",
    "d3": "^7.9.0",
    "font-awesome": "^4.7.0",
    "js-yaml": "^4.1.0",
    "save-svg-as-png": "^1.4.17",
    "showdown": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "svgo": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
